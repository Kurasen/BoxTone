**/node_modules
**/oh_modules
/local.properties
/.idea
**/build
**/.hvigor
**/.cxx
/.clangd
/.clang-format
/.clang-tidy
**/.test
/.appanalyzer
/.codegenie
/.workbuddy
# 发布签名材料：密钥库、证书、profile 和密码都不入库
/signing
.tmp_cert.pem
**/*.p12
**/*.csr
**/*.cer
**/*.p7b
**/keystore-password.txt
# 反馈服务依赖与本地配置
/server/node_modules
/server/.env*
!/server/.env.example
/server.zip
*.pem
*.jks
*.keystore
# 离线自检的临时转译目录（tools/verify-logic.mjs 生成）
/.verify-tmp
# 商店素材与截图脚本：体积大且与代码无关，仅本地保留
/store
# 构建产物（按编译模式 + 签名分开存放的 HAP）：可随时重新生成，不入库
/dist
# 逆向分析用的临时目录（拆包出的第三方 exe 与字节码）
/.ofb

# 无线调试地址缓存（tools/dev.sh 自动记录）
/tools/.hdc-target

# CodeArts / opencode 本地工具目录
/.opencode/

# 自测录音素材：本地采集的原始录音，文件名含中文会让 pre-commit 钩子的路径转义失败
/tools/recordings
