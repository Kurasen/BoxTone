{
  "app": {
    "signingConfigs": [
      /*
       * 调试签名（DevEco 自动生成的调试证书）
       *
       * 材料放在本地 signing/debug/，该目录已被 .gitignore 排除。
       * 密码为空：构建时由 hvigorfile.ts 的插件读取
       * signing/debug-password.txt，用 signing/debug/material 加密后注入。
       *
       * 若在 DevEco 里重新生成过调试签名，新密钥库的密码会变，
       * 需要把新密码补回 signing/debug-password.txt（否则签名为空会报 00303116）。
       */
      {
        "name": "debug",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "signing/debug/boxtone-debug.p12",
          "storePassword": "",
          "keyAlias": "debugKey",
          "keyPassword": "",
          "signAlg": "SHA256withECDSA",
          "profile": "signing/debug/boxtone_profileDebug.p7b",
          "certpath": "signing/debug/boxtone-debug_cer.cer"
        }
      },
      /*
       * 发布签名（AppGallery Connect）
       *
       * 真实签名材料放在本地 signing/ 目录，该目录已被 .gitignore 排除。
       * 密码字段保持为空，由 hvigorfile.ts 在 release 构建时读取
       * signing/keystore-password.txt 并加密注入，不写入仓库。
       *
       * 注意：hvigor 解密用的 material 固定取 storeFile 同级的 material/ 目录
       * （见 hvigor-ohos-plugin/utils/decipher-util.js），所以调试和发布
       * 各用各的材料，不能混用。
       */
      {
        "name": "release",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "signing/boxtone-release.p12",
          "storePassword": "",
          "keyAlias": "boxtone",
          "keyPassword": "",
          "signAlg": "SHA256withECDSA",
          "profile": "signing/boxtone_profileRelease.p7b",
          "certpath": "signing/boxtone-release_cer.cer"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "debug",
        "compatibleSdkVersion": "6.1.0(23)",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
