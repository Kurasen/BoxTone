#!/bin/sh
ROOT="$(git rev-parse --show-toplevel)"
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$ROOT/tools/check-sensitive-staged.ps1"
fi
if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT/tools/check-sensitive-staged.ps1"
fi
echo "Secret check failed: PowerShell is not available." >&2
exit 1
