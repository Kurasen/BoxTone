# 运行前复制为 .env，并填入真实值（node --env-file=.env feedback-server.mjs）

# 服务监听
PORT=8787
HOST=0.0.0.0

# App 端 FeedbackApiConfig.TOKEN 必须与这里一致；留空服务会拒绝启动
FEEDBACK_TOKEN=change-me-to-a-long-random-string

# 发信邮箱（QQ 邮箱 SMTP）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-account@example.com
# QQ 邮箱设置 → 账户 → 开启 SMTP 后生成的授权码
SMTP_PASS=

# 收件地址，留空则发给 SMTP_USER
MAIL_TO=your-account@example.com
